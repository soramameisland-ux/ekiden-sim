/* 大学駅伝 — M1 のプレースホルダーの見た目。寸法は 08 §2・§4(基準の高さ 360 u。1 u = 1 px のパネル座標)。 */
:root {
    --c-bg: rgb(22, 26, 33);
    --c-panel: rgb(34, 40, 50);
    --c-panel2: rgb(44, 52, 64);
    --c-line: rgb(70, 80, 96);
    --c-text: rgb(232, 236, 241);
    --c-sub: rgb(160, 170, 184);
    --c-accent: rgb(56, 132, 220);
    --c-accent-d: rgb(36, 96, 170);
    --c-good: rgb(76, 175, 110);
    --c-warn: rgb(230, 170, 50);
    --c-bad: rgb(220, 80, 70);
    --c-focus: rgb(255, 214, 90);
    -unity-font-definition: url("project://database/Assets/Fonts/NotoSansJP-Regular-SDF.asset");
    font-size: 14px;
    color: var(--c-text);
}

.root { flex-grow: 1; background-color: var(--c-bg); }
.scale-125 { font-size: 17.5px; }
.scale-150 { font-size: 21px; }

/* ---- ヘッダ(40 u)・内容・操作バー(56 u) ---- */
.header { height: 40px; flex-direction: row; align-items: center; padding-left: 8px; padding-right: 8px; background-color: var(--c-panel); border-bottom-width: 1px; border-bottom-color: var(--c-line); }
.header-title { font-size: 20px; -unity-font-style: bold; margin-left: 6px; flex-shrink: 0; }
.header-summary { flex-grow: 1; -unity-text-align: middle-right; color: var(--c-sub); font-size: 12px; margin-right: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.content { flex-grow: 1; flex-direction: row; padding: 6px 12px; }
.footer { height: 56px; flex-direction: row; align-items: center; justify-content: flex-end; padding-left: 12px; padding-right: 12px; background-color: var(--c-panel); border-top-width: 1px; border-top-color: var(--c-line); }

/* ---- 領域 ---- */
.region { flex-grow: 1; flex-basis: 0; margin: 0 3px; overflow: hidden; }
.region-fixed { flex-grow: 0; }
.region-title { font-size: 12px; color: var(--c-sub); margin-bottom: 2px; }
.col { flex-direction: column; }
.row { flex-direction: row; align-items: center; }
.wrap { flex-wrap: wrap; }
.grow { flex-grow: 1; }
.scroll { flex-grow: 1; }

/* ---- 文字 ---- */
.title { font-size: 20px; -unity-font-style: bold; margin-bottom: 4px; }
.big { font-size: 28px; -unity-font-style: bold; }
.sub { color: var(--c-sub); font-size: 12px; }
.bold { -unity-font-style: bold; }
.good { color: var(--c-good); }
.warn { color: var(--c-warn); }
.bad { color: var(--c-bad); }
.dev-missing { color: rgb(255, 90, 90); }
.label { white-space: normal; margin: 1px 0; }
.nowrap { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ---- 行(操作できる 48 u / 読むだけ 24 u) ---- */
.line { height: 24px; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-color: rgba(70, 80, 96, 0.5); }
.cell { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 6px; }
.cell-num { -unity-text-align: middle-right; }
.own { background-color: rgba(56, 132, 220, 0.25); }

/* ---- ボタン ---- */
.unity-button, .btn {
    min-height: 40px; min-width: 48px; margin: 3px; padding: 0 12px;
    background-color: var(--c-panel2); border-width: 1px; border-color: var(--c-line); border-radius: 4px;
    color: var(--c-text); -unity-text-align: middle-center; white-space: nowrap;
}
/* 既定のテーマの .unity-button より後・同じ強さで上書きする */
.unity-button:hover { background-color: rgb(56, 66, 82); }
.unity-button:active { background-color: rgb(30, 36, 46); }
.unity-button:disabled { color: rgb(110, 118, 130); background-color: rgb(36, 40, 48); opacity: 1; }
.unity-button:focus { border-color: var(--c-focus); border-width: 2px; }
.unity-button.btn-primary { background-color: var(--c-accent-d); border-color: var(--c-accent); -unity-font-style: bold; }
.unity-button.btn-primary:hover { background-color: var(--c-accent); }
.btn-row { min-height: 44px; -unity-text-align: middle-left; padding-left: 8px; margin: 1px 0; flex-direction: row; align-items: center; }
.unity-button.btn-row.selected { background-color: rgba(56, 132, 220, 0.35); }
.btn-tile { width: 140px; height: 48px; }
.btn-card { width: 132px; min-height: 140px; flex-direction: column; justify-content: flex-start; padding: 8px; white-space: normal; -unity-text-align: upper-left; }
.unity-button.btn-card.selected { border-color: var(--c-accent); border-width: 2px; background-color: rgba(56, 132, 220, 0.25); }
.btn-small { min-height: 28px; min-width: 32px; padding: 0 6px; font-size: 12px; }

TextField { min-height: 36px; }
TextField > .unity-text-field__input { background-color: var(--c-panel2); color: var(--c-text); border-color: var(--c-line); font-size: 14px; }

/* ---- 部品 ---- */
.card { background-color: var(--c-panel); border-radius: 4px; padding: 8px; margin: 3px; }
.chip { background-color: var(--c-panel2); border-radius: 8px; padding: 1px 6px; margin: 1px 2px; font-size: 12px; }
.gauge { height: 6px; background-color: var(--c-panel2); border-radius: 3px; flex-grow: 1; }
.gauge-fill { height: 6px; border-radius: 3px; }
.sep { height: 1px; background-color: var(--c-line); margin: 4px 0; }

/* ---- 重なる表示(ダイアログ・トースト) ---- */
.overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.55); align-items: center; justify-content: center; }
.dialog { background-color: var(--c-panel); border-width: 1px; border-color: var(--c-line); border-radius: 6px; padding: 12px; min-width: 320px; max-width: 560px; max-height: 330px; }
.dialog-body { margin-bottom: 8px; }
.dialog-buttons { flex-direction: row; justify-content: flex-end; flex-wrap: wrap; }
.toast { position: absolute; left: 20%; right: 20%; bottom: 64px; background-color: rgba(20, 24, 30, 0.95); border-color: var(--c-warn); border-width: 1px; border-radius: 4px; padding: 6px 10px; -unity-text-align: middle-center; white-space: normal; }
.hidden { display: none; }
